# ===== CRITICAL: Change these for production =====
SECRET_KEY=dev-secret-key-for-testing-only-change-in-production
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=news_intelligence
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1

# ===== News API Keys =====
NEWSAPI_KEY=your_newsapi_key_here
GNEWS_API_KEY=your_gnews_api_key_here

# ===== RSS Feeds (Malaysia English news sources) =====
RSS_FEEDS=https://www.freemalaysiatoday.com/feed/,https://www.freemalaysiatoday.com/category/nation/feed/,https://www.freemalaysiatoday.com/category/business/feed/,https://www.freemalaysiatoday.com/category/world/feed/,https://www.nst.com.my/feed,https://www.bernama.com/en/rssfeed.php

# ===== JWT Configuration =====
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ===== Email Notifications (SMTP) =====
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords), not your regular password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=News Intelligence

# ===== Feature Flags (LaunchDarkly) =====
LD_SDK_KEY=your_launchdarkly_sdk_key_here

# ===== NLP Pipeline Configuration =====
WORKER_INTERVAL_MINUTES=30
TRUST_WEIGHT_SOURCE_REPUTATION=0.40
TRUST_WEIGHT_CROSS_SOURCE=0.35
TRUST_WEIGHT_SEMANTIC_SIMILARITY=0.00
TRUST_WEIGHT_HEADLINE_CONSISTENCY=0.12
TRUST_WEIGHT_METADATA_COMPLETENESS=0.13
