# Copy to backend/.env for local development (never commit the real file).
# For the production server use deploy/production.env.example instead.

# --- Core ---
ENVIRONMENT=development
# Required in production: a random string of at least 32 characters.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=news_intelligence
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- News collection ---
# RSS_FEEDS defaults to the configured Malaysian publishers; override only if needed.
# RSS_FEEDS=https://www.nst.com.my/feed,https://www.bernama.com/en/rssfeed.php
WORKER_INTERVAL_MINUTES=15
# Optional, not used by the active RSS collection:
NEWSAPI_KEY=
GNEWS_API_KEY=

# --- Email digests ---
EMAIL_TIMEZONE=Asia/Kuala_Lumpur
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords), not your regular password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CandorNews
