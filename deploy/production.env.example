# Production settings for docker-compose.prod.yml.
# Copy to deploy/production.env ON THE SERVER and fill in. Never commit the real file.

# Public address of the site, without https:// (for example candornews.duckdns.org
# or 203.0.113.10.sslip.io). Caddy gets the HTTPS certificate for it automatically.
DOMAIN=

# --- Backend ---
ENVIRONMENT=production
# Random, at least 32 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DATABASE_NAME=news_intelligence
# Must match DOMAIN, with https://
CORS_ORIGINS=https://your-domain-here
EMAIL_TIMEZONE=Asia/Kuala_Lumpur
WORKER_INTERVAL_MINUTES=30

# --- Email (Gmail App Password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CandorNews
